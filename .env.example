# Copy to .env; scripts/start.sh generates local secrets automatically.
NODE_ENV=development
PORT=4000
WEB_PORT=5173
PMA_PORT=8088
DB_HOST=127.0.0.1
DB_PORT=3307
MYSQL_PORT=3307
DB_NAME=scm_leave
DB_USER=scm
DB_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
DB_SSL=false
# For Aiven: DB_SSL=true and put the complete CA PEM in DB_SSL_CA (Render env)
# or use DB_SSL_CA_FILE=/path/to/ca.pem for host-local migration.
DB_SSL_CA=
DB_SSL_CA_FILE=
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
SESSION_HOURS=12
# 32 random bytes, base64. KEEP THE SAME KEY for existing encrypted images.
FILE_ENCRYPTION_KEY=replace-with-base64-32-bytes
BOOTSTRAP_ADMIN_EMAIL=admin@scm.local
BOOTSTRAP_ADMIN_NAME=SCM Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
SEED_DEMO=false
DEMO_PASSWORD=
